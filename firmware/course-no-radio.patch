+; The course build. Same source, one flag: both SX1262 are held in reset and
+; every call that would drive them is compiled out. The board cannot transmit
+; or receive on any band, which is a property somebody can verify rather than
+; a promise somebody has to trust.
+;
+;   pio run -e pico_tinyusb_norf
+;
+[env:pico_tinyusb_norf]
+extends = env:pico_tinyusb
+build_flags = -DUSE_TINYUSB -DFLATSAT_NO_RADIO=1
diff -ruN --exclude=.pio --exclude=.gitignore .orig/radio_off.cpp Firmware/radio_off.cpp
--- .orig/radio_off.cpp	1969-12-31 18:00:00
+++ Firmware/radio_off.cpp	2026-11-06 21:17:44
@@ -0,0 +1,33 @@
+/*  - radio_off.cpp
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "radio_off.h"
+
+#if FLATSAT_NO_RADIO
+#include "pins.h"
+#include <Arduino.h>
+
+void radioHoldInReset(void) {
+  /* RESET low, and keep it low. The SX1262 stays in reset while the board is
+   * powered, so neither module can transmit or receive. */
+  pinMode(PIN_RADIO0_RST, OUTPUT);
+  digitalWrite(PIN_RADIO0_RST, LOW);
+  pinMode(PIN_RADIO1_RST, OUTPUT);
+  digitalWrite(PIN_RADIO1_RST, LOW);
+
+  /* Antenna switches off as well. Belt and braces: even a module that somehow
+   * came out of reset would not reach the antenna. */
+  pinMode(PIN_RADIO0_ANT_SW, OUTPUT);
+  digitalWrite(PIN_RADIO0_ANT_SW, LOW);
+  pinMode(PIN_RADIO1_ANT_SW, OUTPUT);
+  digitalWrite(PIN_RADIO1_ANT_SW, LOW);
+
+  /* Chip selects high (deselected), so nothing on the shared SPI bus talks to
+   * a radio by accident. */
+  pinMode(PIN_RADIO0_NSS, OUTPUT);
+  digitalWrite(PIN_RADIO0_NSS, HIGH);
+  pinMode(PIN_RADIO1_NSS, OUTPUT);
+  digitalWrite(PIN_RADIO1_NSS, HIGH);
+}
+#endif /* FLATSAT_NO_RADIO */
diff -ruN --exclude=.pio --exclude=.gitignore .orig/radio_off.h Firmware/radio_off.h
--- .orig/radio_off.h	1969-12-31 18:00:00
+++ Firmware/radio_off.h	2026-11-06 21:17:44
@@ -0,0 +1,31 @@
+/*  - radio_off.h
+ *
+ * Course build: the two SX1262 modules are held in reset and never configured.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifndef FIRMWARE_RADIO_OFF_H
+#define FIRMWARE_RADIO_OFF_H
+
+#if FLATSAT_NO_RADIO
+
+/* Drive both radios into reset and both antenna switches off, before anything
+ * else runs. Call it first in setup().
+ *
+ * Compiling the radio calls out is not enough on its own: the chips would
+ * still power up in their default state, and anything that reached RadioLib
+ * later could key them. Holding RESET low keeps the SX1262 in reset for as
+ * long as the board is powered, so it cannot modulate a carrier whatever the
+ * firmware above it does. That is a property somebody can verify with a
+ * spectrum analyser, which is the point. */
+void radioHoldInReset(void);
+
+/* What the version reply tells the ground, so the state is readable from the
+ * console instead of taken on trust. */
+#define FLATSAT_RADIO_STATE_STR "disabled (held in reset, course build)"
+
+#else
+#define FLATSAT_RADIO_STATE_STR "enabled"
+#endif /* FLATSAT_NO_RADIO */
+
+#endif // FIRMWARE_RADIO_OFF_H
